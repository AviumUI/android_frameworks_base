<!-- res/layout/big_boom_lock_clock.xml -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/big_boom_clock_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Central disc, only visible when no notifications -->
    <ImageView
        android:id="@+id/center_disc"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="invisible" /> 

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/center_disc"
        app:layout_constraintBottom_toBottomOf="@id/center_disc"
        app:layout_constraintStart_toStartOf="@id/center_disc"
        app:layout_constraintEnd_toEndOf="@id/center_disc"
        android:visibility="invisible" />

    <!-- Clock Digits -->
    <ImageView android:id="@+id/iv_hour1" style="@style/BigBoomClockDigit" />
    <ImageView android:id="@+id/iv_hour2" style="@style/BigBoomClockDigit" />
    <ImageView android:id="@+id/iv_minute1" style="@style/BigBoomClockDigit" />
    <ImageView android:id="@+id/iv_minute2" style="@style/BigBoomClockDigit" />

</androidx.constraintlayout.widget.ConstraintLayout>